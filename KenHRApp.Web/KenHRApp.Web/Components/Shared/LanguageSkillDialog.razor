@using KenHRApp.Web.Components.Common

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@DialogIcon" Class="mr-1" Size="Size.Medium" Color="@DialogIconColor" />
            @DialogTitle
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudPaper Elevation="0" Square="true" Class="w-100 px-5">
                <MudGrid Spacing="7">
                    <MudItem xs="3">
                        <MudPaper Elevation="0" Class="p-0 w-100">
                            <MudAutocomplete @bind-Value="LanguageSkill.LanguageDesc"
                                             For="@(() => LanguageSkill.LanguageDesc)"
                                             SearchFunc="SearchLanguage!"
                                             Variant="Variant.Text"
                                             Label="Level"
                                             Margin="Margin.Dense"
                                             Dense="true"
                                             Placeholder="Please Select"
                                             HelperText="Type a key to search for language"
                                             HelperTextOnFocus="true"
                                             Clearable="@IsClearable" Typo="Typo.subtitle2"
                                             MaxItems="@(LanguageList != null ? LanguageList.Count : 10)"
                                             Modal="true" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="9">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Breakpoint="Breakpoint.Xs" Class="pt-3">
                            <MudSwitch @bind-Value="LanguageSkill.CanRead" Color="Color.Info" UncheckedColor="Color.Default" LabelPlacement="Placement.Start">Can Read?</MudSwitch>
                            <MudSwitch @bind-Value="LanguageSkill.CanSpeak" Color="Color.Info" UncheckedColor="Color.Default" LabelPlacement="Placement.Start">Can Speak?</MudSwitch>
                            <MudSwitch @bind-Value="LanguageSkill.CanWrite" Color="Color.Info" UncheckedColor="Color.Default" LabelPlacement="Placement.Start">Can Write?</MudSwitch>
                            <MudSwitch @bind-Value="LanguageSkill.MotherTongue" Color="Color.Info" UncheckedColor="Color.Default" LabelPlacement="Placement.Start">Mother Tongue?</MudSwitch>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Info" Style="background-color:#004165;" Variant="Variant.Filled" Size="Size.Medium" OnClick="Save">Save</MudButton>
        <MudButton Color="Color.Default" Variant="Variant.Text" Size="Size.Medium" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    #region Fields
    private MudForm _form = new();
    private string[]? _languageArray = null;
    #endregion

    #region Parameters and Injections
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public LanguageSkillDTO LanguageSkill { get; set; } = new();

    [Parameter]
    public IReadOnlyList<UserDefinedCodeDTO> LanguageList { get; set; } = new List<UserDefinedCodeDTO>();

    [Parameter]
    public bool IsClearable { get; set; } = true;

    [Parameter]
    public bool IsDisabled { get; set; } = true;

    [Parameter]
    public bool IsEditMode { get; set; }

    // Optional UI helpers
    protected string DialogTitle => IsEditMode ? "Edit Language" : "Add New Language";
    protected string DialogIcon => IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add;
    protected Color DialogIconColor => IsEditMode ? Color.Info : Color.Success;
    #endregion

    #region Page Methods
    protected override void OnInitialized()
    {
        if (LanguageList != null)
            _languageArray = LanguageList.Select(d => d.UDCDesc1).OrderBy(d => d).ToArray();
    }
    #endregion

    #region Private Methods
    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(LanguageSkill));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task<IEnumerable<string>> SearchLanguage(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
        {
            return _languageArray!;
        }

        return _languageArray!.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    #endregion
}
