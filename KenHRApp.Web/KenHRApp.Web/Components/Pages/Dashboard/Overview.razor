@page "/dashboard"
@page "/dashboard/overview"
@using KenHRApp.Web.Components.Shared

<PageTitle>Dashboard · KEN-HR</PageTitle>

<div class="hr-dashboard">

    <!-- =====================================================
         HERO HEADER
         ===================================================== -->
    <section class="dashboard-hero">

        <div class="hero-content">
            <MudText Class="hero-eyebrow">
                KEN-HR • PEOPLE OPERATIONS
            </MudText>

            <MudText Class="hero-title">
                Workforce overview
            </MudText>

            <MudText Class="hero-description">
                A clear view of your workforce, attendance and people activity
                across the organisation.
            </MudText>
        </div>

        <div class="hero-actions">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Download"
                       Class="dashboard-outline-button">
                Export
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Style="background-color:#004165;"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="AddNewEmployee"
                       Class="dashboard-primary-button">
                Add employee
            </MudButton>

        </div>

    </section>


    <!-- =====================================================
         KPI SECTION
         ===================================================== -->
    <section class="kpi-section">

        <div class="section-heading">
            <div>
                <MudText Class="section-title">
                    Today's workforce
                </MudText>

                <MudText Class="section-description">
                    Key people metrics at a glance
                </MudText>
            </div>

            <div class="live-indicator">
                <span class="live-dot"></span>
                Live
            </div>
        </div>


        <MudGrid Spacing="2">

            <!-- Headcount -->
            <MudItem xs="12" sm="6" md="3">

                <div class="executive-kpi kpi-blue">

                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <span class="kpi-label">
                            HEADCOUNT
                        </span>
                    </div>

                    <div class="kpi-value">
                        @Kpis.Headcount.ToString("N0")
                    </div>

                    <div class="kpi-footer">
                        <span class="kpi-positive">
                            <i class="fa-solid fa-arrow-up"></i>
                            2.4%
                        </span>

                        <span>vs last month</span>
                    </div>

                </div>

            </MudItem>


            <!-- Present -->
            <MudItem xs="12" sm="6" md="3">

                <div class="executive-kpi kpi-sage">

                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <i class="fa-solid fa-user-check"></i>
                        </div>

                        <span class="kpi-label">
                            PRESENT TODAY
                        </span>
                    </div>

                    <div class="kpi-value">
                        @Kpis.PresentToday.ToString("N0")
                    </div>

                    <div class="kpi-footer">
                        <span class="kpi-positive">
                            94.2%
                        </span>

                        <span>attendance rate</span>
                    </div>

                </div>

            </MudItem>


            <!-- Leave -->
            <MudItem xs="12" sm="6" md="3">

                <div class="executive-kpi kpi-sand">

                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <i class="fa-solid fa-umbrella-beach"></i>
                        </div>

                        <span class="kpi-label">
                            ON LEAVE
                        </span>
                    </div>

                    <div class="kpi-value">
                        @Kpis.OnLeave.ToString("N0")
                    </div>

                    <div class="kpi-footer">
                        <span class="kpi-neutral">
                            -3
                        </span>

                        <span>vs yesterday</span>
                    </div>

                </div>

            </MudItem>


            <!-- Recruitment -->
            <MudItem xs="12" sm="6" md="3">

                <div class="executive-kpi kpi-indigo">

                    <div class="kpi-top">
                        <div class="kpi-icon">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>

                        <span class="kpi-label">
                            OPEN ROLES
                        </span>
                    </div>

                    <div class="kpi-value">
                        @Kpis.OpenRequisitions.ToString("N0")
                    </div>

                    <div class="kpi-footer">
                        <span class="kpi-positive">
                            +6
                        </span>

                        <span>this month</span>
                    </div>

                </div>

            </MudItem>

        </MudGrid>

    </section>


    <!-- =====================================================
         ANALYTICS
         ===================================================== -->
    <section class="analytics-section">

        <div class="section-heading analytics-heading">

            <div>
                <MudText Class="section-title">
                    Workforce analytics
                </MudText>

                <MudText Class="section-description">
                    Understand workforce movement and attendance patterns.
                </MudText>
            </div>

        </div>


        <MudGrid Spacing="2">

            <!-- =================================================
                 HEADCOUNT TREND
                 ================================================= -->
            <MudItem xs="12" lg="8">

                <div class="dashboard-surface large-chart">

                    <div class="surface-header">

                        <div>
                            <MudText Class="surface-title">
                                Headcount trend
                            </MudText>

                            <MudText Class="surface-description">
                                Workforce growth over the last 12 months
                            </MudText>
                        </div>

                        <div class="surface-icon blue-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>

                    </div>

                    <div class="chart-container">

                        <MudChart ChartType="ChartType.Line"
                                  ChartSeries="@HeadcountSeries"
                                  XAxisLabels="@Months"
                                  Width="100%"
                                  Height="300px" />

                    </div>

                </div>

            </MudItem>


            <!-- =================================================
                 DIVISION
                 ================================================= -->
            <MudItem xs="12" lg="4">

                <div class="dashboard-surface division-chart">

                    <div class="surface-header">

                        <div>
                            <MudText Class="surface-title">
                                Workforce by division
                            </MudText>

                            <MudText Class="surface-description">
                                Employee distribution
                            </MudText>
                        </div>

                        <div class="surface-icon sage-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>

                    </div>

                    <div class="donut-container">

                        <MudChart ChartType="ChartType.Donut"
                                  InputData="@DivisionData"
                                  InputLabels="@DivisionLabels"
                                  Width="100%"
                                  Height="270px" />

                    </div>

                </div>

            </MudItem>


            <!-- =================================================
                 ATTENDANCE
                 ================================================= -->
            <MudItem xs="12" lg="7">

                <div class="dashboard-surface">

                    <div class="surface-header">

                        <div>
                            <MudText Class="surface-title">
                                Attendance this week
                            </MudText>

                            <MudText Class="surface-description">
                                Daily workforce attendance
                            </MudText>
                        </div>

                        <div class="surface-icon blue-icon">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>

                    </div>

                    <MudChart ChartType="ChartType.Bar"
                              ChartSeries="@AttendanceSeries"
                              XAxisLabels="@Weekdays"
                              Width="100%"
                              Height="270px" />

                </div>

            </MudItem>


            <!-- =================================================
                 RECENT ACTIVITY
                 ================================================= -->
            <MudItem xs="12" lg="5">

                <div class="dashboard-surface activity-surface">

                    <div class="surface-header">

                        <div>
                            <MudText Class="surface-title">
                                Recent activity
                            </MudText>

                            <MudText Class="surface-description">
                                Latest people operations
                            </MudText>
                        </div>

                        <div class="surface-icon sand-icon">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>

                    </div>

                    <div class="activity-container">
                        <Timeline Entries="Activity" />
                    </div>

                </div>

            </MudItem>

        </MudGrid>

    </section>

</div>