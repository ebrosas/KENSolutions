@page "/dashboard"
@page "/dashboard/overview"
@using KenHRApp.Web.Components.Shared

<PageTitle>Dashboard · KEN-HR</PageTitle>

<PageHeader Title="Workforce overview" Description="Live headcount, attendance and payroll signals across the organisation.">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Export</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/core-hr/employees">Add employee</MudButton>
    </Actions>
</PageHeader>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Total headcount" Value="@Kpis.Headcount.ToString("N0")" Icon="fa-solid fa-users" Trend="+2.4% MoM" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Present today" Value="@Kpis.PresentToday.ToString("N0")" Icon="fa-solid fa-user-check" Color="Color.Success" Trend="94.2% attendance" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="On leave" Value="@Kpis.OnLeave.ToString("N0")" Icon="fa-solid fa-umbrella-beach" Color="Color.Warning" Trend="-3 vs. yesterday" TrendPositive="false" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Open requisitions" Value="@Kpis.OpenRequisitions.ToString("N0")" Icon="fa-solid fa-briefcase" Color="Color.Tertiary" Trend="+6 this month" />
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-4">Headcount trend</MudText>
            <MudChart ChartType="ChartType.Line"
                      ChartSeries="@HeadcountSeries"
                      XAxisLabels="@Months"
                      Width="100%"
                      Height="320px" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-4">Workforce by division</MudText>
            <MudChart ChartType="ChartType.Donut"
                      InputData="@DivisionData"
                      InputLabels="@DivisionLabels"
                      Width="100%"
                      Height="300px" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-4">Attendance this week</MudText>
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@AttendanceSeries"
                      XAxisLabels="@Weekdays"
                      Width="100%"
                      Height="300px" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-2">Recent activity</MudText>
            <Timeline Entries="Activity" />
        </MudPaper>
    </MudItem>
</MudGrid>